# ---------------------------------------------------------------------------
# Authentication configuration
# Copy to `.env.local` and adjust. Every value below is optional; documented
# defaults apply when a variable is missing.
# ---------------------------------------------------------------------------

# Driver: sanctum-spa | sanctum-token | none
VITE_AUTH_DRIVER=none

# Laravel application origin. The shared Axios client targets this URL.
VITE_API_BASE_URL=http://localhost:8000

# Endpoint paths (relative to VITE_API_BASE_URL).
VITE_AUTH_LOGIN_ENDPOINT=/login
VITE_AUTH_LOGOUT_ENDPOINT=/logout
VITE_AUTH_USER_ENDPOINT=/api/user
VITE_AUTH_CSRF_ENDPOINT=/sanctum/csrf-cookie
VITE_AUTH_FORGOT_PASSWORD_ENDPOINT=/forgot-password
VITE_AUTH_RESET_PASSWORD_ENDPOINT=/reset-password

# Token driver only.
# `memory` (default, recommended) or `sessionStorage` (XSS warning).
VITE_AUTH_TOKEN_STORAGE=memory
# Dot path of the token in the login response, e.g. `token` or `data.token`.
VITE_AUTH_TOKEN_RESPONSE_PATH=token

# Simulated Laravel Sanctum backend inside the Axios adapter.
# Defaults to `true` in development and `false` in production builds.
# VITE_AUTH_MOCK=true

# Allow switching drivers at runtime outside development. Off by default:
# production driver selection stays deployment-controlled.
# VITE_AUTH_ALLOW_RUNTIME_SWITCH=false
